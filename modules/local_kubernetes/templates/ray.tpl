# ray default values generated by Terraform
#
# Ephemeral RayJob platform. Nothing here creates a Ray cluster: the chart only
# renders the RBAC and the RayJob pod-spec skeleton that the application patches
# and submits at runtime. Ray clusters exist only while a job runs.
ray:
  enabled: ${ray_enabled}

  # Namespace RayJobs are created in. Not "default" -- Ray's job submission API
  # has no authentication, so RayJobs are kept out of the shared namespace.
  namespace: "${ray_namespace}"

  # Ray version for the head/worker containers. Keep current; the floor from the
  # 2023 CVEs is 2.8.1.
  rayVersion: "${ray_version}"

  # Bulk uploads as RayJobs (enable_ray_upload). Emitted with the service account
  # grants it needs, so the two cannot drift apart.
  upload: ${ray_upload_enabled}

  # Credentials mounted into Ray pods. This is the dedicated least-privilege Ray
  # service account (cloudsql.client + objectAdmin on the deltalake bucket only),
  # NOT the materialize key -- anything reaching the Ray head gets arbitrary code
  # execution, so the mounted credential is scoped as tightly as the job allows.
  credentialsSecret: "${ray_sa_secret}"
  secretFiles:
    - name: google-secret.json
      value: "ref+gcpsecrets://${secrets_project_id}/${ray_sa_secret}"
    - name: cave-secret.json
      value: "ref+gcpsecrets://${secrets_project_id}/${cave_secret_name}"

  # Job lifecycle. shutdownAfterJobFinishes is what makes this cost nothing at
  # rest: KubeRay deletes the whole RayCluster when the entrypoint exits.
  shutdownAfterJobFinishes: true
  # DELAY before KubeRay deletes the RayCluster and submitter -- NOT how long the
  # RayJob CR is kept. The CR survives regardless, because the operator's
  # DELETE_RAYJOB_CR_AFTER_JOB_FINISHES defaults to false, and that is what the
  # api's status endpoint reads. Pod logs go to Cloud Logging either way.
  #
  # So this buys only a `kubectl logs` window on the pods themselves, and it is
  # charged at a full head pod (2 CPU / 8Gi on standard-pool) for the duration.
  # 60s is a debugging grace period; anything on the order of an hour means every
  # job leaves an idle head running for an hour after it finishes.
  ttlSecondsAfterFinished: 60
  # The ONLY backstop against a wedged job pinning mesh-pool nodes: Ray worker
  # pods are owned by the RayCluster CR, which the cluster autoscaler will not
  # evict pods on behalf of. Set deliberately.
  activeDeadlineSeconds: 86400
  backoffLimit: 1

  # Worker sizing. Requests must leave room for DaemonSets on a
  # t2d-standard-4 mesh-pool node (4 vCPU / 16Gi) so several workers pack per
  # node -- an oversized request silently turns each worker into a whole node.
  maxWorkers: 20
  worker:
    resources:
      requests:
        cpu: 1000m
        memory: 3Gi

  # The driver runs on the head, and deltalake's z-order sort is driver-side.
  head:
    resources:
      requests:
        cpu: 2000m
        memory: 8Gi

  cloudsql:
    projectId: "${sql_project_id}"
    sqlInstanceName: "${sql_instance_name}"
