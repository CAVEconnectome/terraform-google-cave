redis:
  host: "ref+tfstate${terraform_state_url}/output.auth_redis_host"
auth:
  oauthSecretFilename: "${oauth_secret_filename}"
  # Flask session signing key, generated by Terraform and held in Secret Manager.
  secretKey: "ref+gcpsecrets://${secrets_project_id}/${auth_secret_key_name}"
  # Google OAuth web client JSON. Created by hand in the Cloud console and
  # stored in Secret Manager (see GLOBAL_OAUTH_SETUP.md); vals resolves this ref
  # at helmfile time, so the credential never lands on disk or in this repo.
  secretFiles:
    - name: ${oauth_secret_filename}
      value: "ref+gcpsecrets://${secrets_project_id}/${oauth_secret_name}"
  # dbName: "auth"
  # defaultAdmins:
  #   - "you@example.org"
regular:
  urlPrefix: "${auth_url_prefix}"
sticky:
  urlPrefix: "${sticky_auth_url_prefix}"
